{
  "name": "railcross",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && tsc -p tsconfig.worker.json",
    "build:css": "vite build",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome",
    "deploy": "npm run build && wrangler deploy",
    "dev": "wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "start": "wrangler dev",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch"
  },
  "dependencies": {
    "@mridang/nestjs-defaults": "^3.2.0",
    "@mridang/nestjs-platform-cloudflare": "^1.2.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/serve-static": "^12.1.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^18.0.0",
    "@octokit/webhooks": "^14.2.0",
    "@octokit/webhooks-types": "^7.6.1",
    "@sentry/cloudflare": "^11.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "murmurhash": "^2.0.1",
    "preact": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "engines": {
    "node": "24.x"
  },
  "description": "Railcross prevents your teams from merging pull requests outside merge windows.",
  "license": "Apache-2.0",
  "author": "Mridang Agarwalla",
  "sideEffects": true,
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public",
    "worker.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/railcross.git"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.5.2",
    "@mridang/eslint-defaults": "^2.1.0",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.6.2",
    "cypress": "^16.2.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "knip": "^6.44.2",
    "nock": "^15.0.6",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "@eslint/core": "1.2.1",
    "multer": "2.5.0",
    "wrangler": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    }
  }
}
