{
  "name": "railcross",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:css": "vite build",
    "build": "npm run build:css && tsc -p tsconfig.worker.json",
    "deploy": "npm run build && wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:watch": "npm run test -- --watch",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome"
  },
  "dependencies": {
    "@mridang/nestjs-defaults": "^3.2.0",
    "@mridang/nestjs-platform-cloudflare": "^1.2.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/serve-static": "^12.1.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^18.0.0",
    "@octokit/webhooks": "^14.2.0",
    "@octokit/webhooks-types": "^7.6.1",
    "@sentry/cloudflare": "^11.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "murmurhash": "^2.0.1",
    "preact": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "url": "https://github.com/mridang/railcross"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.5.2",
    "@mridang/eslint-defaults": "^1.7.0",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.6.2",
    "cypress": "^16.2.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "knip": "^6.43.0",
    "nock": "^15.0.5",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "wrangler": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    }
  }
}
