{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "railcrossapp",
  "main": "worker.mjs",
  "account_id": "779037e608ab1102679ef8b1bd499d49",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Wrangler's own usage telemetry for this project (anonymous CLI usage; the
  // setting overrides each developer's personal preference).
  "send_metrics": true,
  // Workers Observability, everything on at 100% (the volume is tiny and the data
  // is what debugging needs): the app's own log lines, the automatic per-request
  // invocation logs, distributed traces, and real-time Issues. Query strings are
  // stripped from the URLs in logs and traces, because they can carry search
  // text, addresses and sign-in codes.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "issues": { "enabled": true },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  // Custom domain on the Cloudflare-managed `mrida.ng` zone. Cloudflare provisions
  // the DNS record and TLS certificate automatically on deploy. The workers.dev
  // subdomain is disabled so the canonical URL is the one we control.
  "workers_dev": false,
  "routes": [{ "pattern": "railcross.apps.mrida.ng", "custom_domain": true }],
  // Serve the static files in public/ (favicons, fonts, vendored JS) via the
  // Workers assets binding. Non-asset paths fall through to the NestJS worker.
  "assets": {
    "directory": "./public",
  },
  // The deployed version id keys the edge cache, so a deploy never serves old copies.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  // Per-address request limit (the library's rate limiter, binding RL_SITE). The
  // webhook route /hook is never counted. namespace_id is account-wide, so it is
  // unique to this Worker.
  "ratelimits": [
    {
      "name": "RL_SITE",
      "namespace_id": "7401",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "alias": {
    // This app boots on the fetch-native CloudflareAdapter, never Express. NestFactory
    // still statically `require`s @nestjs/platform-express for its default-adapter
    // fallback (a path we never hit), so esbuild would otherwise bundle the whole
    // Express platform as dead weight. Stub it out alongside the other optional
    // platforms Nest lazily pulls in.
    "@nestjs/platform-express": "./empty.cjs",
    "@nestjs/microservices": "./empty.cjs",
    "@nestjs/microservices/microservices-module": "./empty.cjs",
    "@nestjs/websockets": "./empty.cjs",
    "@nestjs/websockets/socket-module": "./empty.cjs",
    "@aws-sdk/client-secrets-manager": "./empty.cjs",
    "@aws-sdk/client-scheduler": "./empty.cjs",
    "@sentry/node": "./empty.cjs",
    "@nestjs/serve-static": "./empty.cjs",
    "@codegenie/serverless-express": "./empty.cjs",
    "@nestjs/graphql": "./empty.cjs",
    "@apollo/subgraph": "./empty.cjs",
    "@apollo/subgraph/package.json": "./empty.json",
    "@apollo/subgraph/dist/directives": "./empty.cjs",
    "ts-morph": "./empty.cjs",
    "class-transformer/storage": "./empty.cjs",
  },
  "kv_namespaces": [
    { "binding": "SCHEDULES", "id": "7f77e9b125194412b894fb78ad4731c9" },
  ],
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULE_ALARMS", "class_name": "ScheduleAlarm" }],
  },
  "migrations": [
    // SQLite-backed Durable Object — available on the Workers free plan.
    { "tag": "v1", "new_sqlite_classes": ["ScheduleAlarm"] },
  ],
  "triggers": {
    // Daily re-registration of the next day's alarms from KV.
    "crons": ["0 0 * * *"],
  },
  "vars": {
    "NODE_ENV": "production",
    "SERVICE_NAME": "railcross",
    "SERVICE_VERSION": "cloudflare",
    "DOMAIN_NAME": "railcross.apps.mrida.ng",
  },
  // Worker secrets (set via `wrangler secret put`), not plaintext vars. A deploy
  // fails if one is missing, and only these names are typed and loaded from .env.
  // SENTRY_DSN is also a secret but optional (Sentry stays off without it), so it is
  // not listed.
  "secrets": {
    "required": [
      "GITHUB_APP_ID",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "GITHUB_PRIVATE_KEY",
      "GITHUB_WEBHOOK_SECRET",
    ],
  },
  // Uploads source maps with the Worker so stack traces in logs and traces
  // point at the original source.
  "upload_source_maps": true,
}
